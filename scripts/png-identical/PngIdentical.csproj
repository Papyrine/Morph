<Project Sdk="Microsoft.NET.Sdk">
  <!-- Used by scripts/regenerate-baselines.sh inside the test container. Decodes with the same
       vendored PngDecoder the scenario comparer uses, so "identical" means identical RGBA pixels. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The vendored decoder leans on the test project's global usings. -->
    <Using Include="System.IO.Compression" />
    <Compile Include="..\..\src\Tests\Compare\PngDecoder.cs" Link="PngDecoder.cs" />
    <Compile Include="..\..\src\Tests\Compare\PngImage.cs" Link="PngImage.cs" />
  </ItemGroup>
</Project>

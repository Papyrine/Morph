<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A trimmed app over the libraries, published and run by scripts/aot-smoke.sh. Publishing hands the
    trimmer the whole app, so a trim hazard any library carries fails the publish (TreatWarningsAsErrors
    covers the trim warnings too), and running the published executable shows the conversions still work
    once the unused code is gone. The libraries' IsAotCompatible analyzers catch most hazards earlier, at
    build time; this is the check that what they let through really runs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackageProject>false</IsPackageProject>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Morph\Morph.csproj" />
    <ProjectReference Include="..\Morph.Skia\Morph.Skia.csproj" />
    <ProjectReference Include="..\Morph.ImageSharp\Morph.ImageSharp.csproj" />
    <ProjectReference Include="..\Morph.Pdf\Morph.Pdf.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
  </ItemGroup>

</Project>

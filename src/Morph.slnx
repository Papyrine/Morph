<Solution>
  <Project Path="Morph/Morph.csproj" />
  <Project Path="Morph.Skia/Morph.Skia.csproj" />
  <Project Path="Morph.ImageSharp/Morph.ImageSharp.csproj" />
  <Project Path="Morph.Pdf/Morph.Pdf.csproj" />
  <Folder Name="/SolutionItems/">
    <File Path="../.editorconfig" />
    <File Path="../.gitattributes" />
    <File Path="../docs/word-features.md" />
    <File Path="../global.json" />
    <File Path="../README.md" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="mdsnippets.json" />
    <File Path="missingTags.md" />
  </Folder>
  <Project Path="RenderHelper/RenderHelper.csproj">
    <Build Solution="Release|*" Project="false" />
  </Project>
  <Project Path="Tests/Tests.csproj" />
  <Project Path="StaticSettingTests/StaticSettingTests.csproj" />
  <Project Path="Benchmarks/Benchmarks.csproj" />
  <!--
    The Blazor WASM converter app and its bUnit/Playwright tests. Like RenderHelper above, these are
    excluded from Release solution builds: the canonical rendering suite builds inside a linux/amd64
    Docker image with no wasm-tools workload, where a Blazor project can't build (the container's
    full-solution build is `dotnet build src -c Release`). They still build locally in Debug and are
    built by path in .github/workflows/deploy-blazor.yml. See Morph.Web/README.md.
  -->
  <Project Path="Morph.Web/Morph.Web.csproj">
    <Build Solution="Release|*" Project="false" />
  </Project>
  <Project Path="Morph.Web.Tests/Morph.Web.Tests.csproj">
    <Build Solution="Release|*" Project="false" />
  </Project>
</Solution>

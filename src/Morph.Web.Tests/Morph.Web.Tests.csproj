<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Public test classes carry no XML docs; ProjectDefaults enables doc generation in Release. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <BlazorPublishDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\blazor-publish\</BlazorPublishDir>
    <WopiSamplePublishDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\wopi-sample-publish\</WopiSamplePublishDir>
  </PropertyGroup>

  <!-- Publish the Blazor app as part of build so the Playwright snapshot tests can serve pre-published output.
       -p:SkipBlazorPublish=true leaves bin/$(Configuration)/blazor-publish as it is: the deploy's test-aot
       job puts the AOT app it deploys there and runs the browser tests against that. -->
  <Target Name="PublishBlazorForTests" AfterTargets="Build" Condition="'$(SkipBlazorPublish)' != 'true'">
    <MSBuild Projects="..\Morph.Web\Morph.Web.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(BlazorPublishDir)" />
  </Target>

  <!-- Publish the WOPI sample, its editor's WebAssembly app with it, for WopiSampleTests to run as a process.
       The sample is no reference of this project, so it is restored here, and in a call of its own: run as
       "Restore;Publish" in one call, the publish evaluates the project before the restore writes the
       package props it imports, and on a clean checkout ProjectDefaults' settings (Nullable among them)
       never reach the compile. The restore's own session id gives it a separate evaluation. -->
  <Target Name="PublishWopiSampleForTests" AfterTargets="Build">
    <MSBuild Projects="..\Morph.Wopi.Sample\Morph.Wopi.Sample.csproj" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="..\Morph.Wopi.Sample\Morph.Wopi.Sample.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(WopiSamplePublishDir)" />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ProjectFiles" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="Verify.Playwright" />
    <PackageReference Include="Verify.Bunit" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="DiffEngine" />
    <ProjectReference Include="..\Morph.Web\Morph.Web.csproj" />
    <!-- Morph.Wopi's endpoints, tested against an OfficeHost host in the same test server (WopiHostTests). -->
    <ProjectReference Include="..\Morph.Wopi\Morph.Wopi.csproj" />
    <PackageReference Include="OfficeHost" />
    <!-- The clock of the coauthoring sessions, moved on by hand: autosave and leaving (CoauthorHostTests). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!-- The service/bUnit tests need a real file of each readable format and the Aptos faces the PDF
       export resolves against; copy both out of the component package's static web assets so the tests
       are self-contained. -->
  <ItemGroup>
    <Content Include="..\Morph.Blazor\wwwroot\sample\sample.*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Morph.Blazor\wwwroot\fonts\*.ttf" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Corpus fixtures for the text-layer snapshots (TextLayerCorpusTests), each picked for one thing the
       layer has to get right: justified lines, tab leaders, rotated cells, header and footer bands,
       warped WordArt, a worksheet grid. -->
  <ItemGroup>
    <Content Include="..\Tests\Inputs\word\align_mixed\input.docx" Link="corpus\align_mixed.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Tests\Inputs\word\table_of_contents\01\input.docx" Link="corpus\table_of_contents.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Tests\Inputs\word\table_text_direction\input.docx" Link="corpus\table_text_direction.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Tests\Inputs\word\header_footer\input.docx" Link="corpus\header_footer.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Tests\Inputs\word\wordart-envelope\input.docx" Link="corpus\wordart-envelope.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Tests\Inputs\excel\inventory-list\input.xlsx" Link="corpus\inventory-list.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What the viewer's review pane reads and edits: a document with tracked changes, one with a comment. -->
  <ItemGroup>
    <Content Include="..\Tests\Inputs\word\tracked_changes\01\input.docx" Link="corpus\tracked_changes.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Tests\Inputs\word\comments\01\input.docx" Link="corpus\comments.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A long real-world document for the editor's benchmark (SnapshotTests.Benchmark.cs): 18 pages of
       tables, lists and text. -->
  <ItemGroup>
    <Content Include="..\Tests\Inputs\word\business-plans\12\input.docx" Link="corpus\business_plan.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

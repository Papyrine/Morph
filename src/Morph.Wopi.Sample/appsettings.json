{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The WOPI host on the first port, Morph on the second: two origins, as they would be deployed.
  "Urls": "http://localhost:5000;http://localhost:5001",
  "Sample": {
    // the folder of the files, relative to the content root
    "Files": "files",
    // the URL the browser opens the host at
    "HostUrl": "http://localhost:5000"
  },
  // The host: OfficeHost's options.
  "OfficeHost": {
    // a development key: use a secret of your own outside of this sample
    "SigningKey": "the signing key of the Morph WOPI sample, do not use it elsewhere",
    // the URL Morph reaches the host at: WOPISrc is {BaseUrl}/wopi/files/{fileId}
    "BaseUrl": "http://localhost:5000",
    // Morph's discovery: the host opens files where it says, and checks the proofs against its keys
    "DiscoveryUrls": [
      "http://localhost:5001/hosting/discovery"
    ],
    // Morph signs every request, so the host can refuse the unsigned
    "RequireProof": true
  },
  // The client: Morph.Wopi's options.
  "MorphWopi": {
    // the URL the host reaches Morph at, which the discovery's action URLs start with
    "BaseUrl": "http://localhost:5001",
    // the hosts Morph opens files for, and lets frame its editor
    "TrustedHosts": [
      "http://localhost:5000"
    ]
  }
}

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Blazor WASM web app (Morph.Web) + its bUnit/Playwright test project. Versions pinned to
         match the .NET 10 runtime the web SDK ships. The web projects are in Morph.slnx but excluded
         from Release solution builds (like RenderHelper), so the linux/amd64 Docker test image — which
         has no wasm-tools workload — never builds a Blazor app. See Morph.Web/README.md. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="Verify.Bunit" Version="13.0.4" />
    <PackageVersion Include="Verify.Playwright" Version="3.1.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.14.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.4.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="PdfSharp" Version="6.2.4" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.174" />
    <PackageVersion Include="SponsorCheck" Version="0.14.0" GitHubSponsorsAccount="Papyrine" SponsorOwner="Papyrine" CheckTransitiveReferences="true" SponsorLandingUrl="https://github.com/sponsors/Papyrine" />
    <SponsorExemption Include="MaintainerConsulting" Message="Organizations that have engaged any of the core maintainers of Papyrine in consulting work could be exempt from the Maintenance Fee for 6 months from the final date of that work." />
    <SponsorExemption Include="SmallRevenue" Message="Consumers under US$10,000 annual gross revenue are exempt." />
    <PackageVersion Include="ProjectFiles" Version="1.4.0" />
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
    <PackageVersion Include="SixLabors.Fonts" Version="3.0.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.0.0" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="3.0.0" />
    <PackageVersion Include="Svg.Skia" Version="5.1.1" />
    <PackageVersion Include="Verify.PDFium" Version="1.2.0" />
    <PackageVersion Include="TUnit" Version="1.60.0" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.ImageMagick" Version="3.8.8" />
    <PackageVersion Include="Verify.TUnit" Version="31.24.2" />
  </ItemGroup>
</Project>
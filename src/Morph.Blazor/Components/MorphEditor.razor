@inherits MorphViewer

@* A word processor in the image of Word's: a File menu and a ribbon of tabs over the pages, a status bar
   under them. It is the viewer underneath — the same pages, find bar and review pane, from the same
   fragments — with a Word document's text edited where it stands. What is typed is the script's until
   the reader moves on; what the ribbon does is an edit to the file, laid out again like any other.

   The ribbon's buttons keep the focus where it was (mousedown is not let take it), so a press acts on
   the paragraph being typed in, and the caret is back in it afterwards. *@

@{
    // What every command on the ribbon is asked of, for this render (MorphEditor.Commands).
    state = State();
}

<div class="@EditorClass" @ref="root" @attributes="AdditionalAttributes" data-editor="">
    <div class="editor-ribbon" aria-busy="@(revising ? "true" : "false")">
        <div class="editor-titlebar">
            <div class="editor-tabs" role="tablist" aria-label="Ribbon">
                <button type="button" class="editor-file" aria-haspopup="menu" aria-expanded="@Expanded(fileMenu)"
                        disabled="@busy" @onmousedown:preventDefault @onclick="() => ToggleMenu(fileMenu)">File</button>
                @foreach (var each in Tabs)
                {
                    var name = each;
                    <button type="button" role="tab" class="editor-tab" aria-selected="@Pressed(ShownTab == name)"
                            disabled="@(!HasDocument)" @onmousedown:preventDefault @onclick="() => tab = name">@name</button>
                }
            </div>
            <span class="editor-name" title="@fileName">
                @fileName
                @if (Dirty)
                {
                    <span class="editor-dirty" title="Edited since it was opened or saved"> — edited</span>
                }
            </span>
            <div class="editor-quick">
                @if (ShowOpenFile)
                {
                    @OpenButton
                }
                @if (SavesInPlace)
                {
                    <button type="button" class="viewer-button" title="Save (Ctrl+S)" aria-label="Save" aria-keyshortcuts="Control+S"
                            disabled="@(!HasDocument || saving)" @onmousedown:preventDefault @onclick="SaveAsync">
                        <Iconify Value="Lucide.Save" aria-hidden="true" focusable="false" />
                    </button>
                }
                else if (ShowDownload)
                {
                    <button type="button" class="viewer-button" title="Save a copy (Ctrl+S)" aria-label="Save a copy" aria-keyshortcuts="Control+S"
                            disabled="@(!HasDocument)" @onmousedown:preventDefault @onclick="DownloadAsync">
                        <Iconify Value="Lucide.Save" aria-hidden="true" focusable="false" />
                    </button>
                }
            </div>
        </div>

        @if (HasDocument)
        {
            <div class="editor-tools" role="tabpanel" aria-label="@ShownTab">
                @switch (ShownTab)
                {
                    case home:
                        @HomeTab
                        break;
                    case insert:
                        @InsertTab
                        break;
                    case layout:
                        @LayoutTab
                        break;
                    case references:
                        @ReferencesTab
                        break;
                    case table:
                        @TableTab
                        break;
                    case reviewTab:
                        @ReviewTab
                        break;
                    default:
                        @ViewTab
                        break;
                }
            </div>
        }
    </div>

    @FindBar

    @if (rulerShown && HasDocument)
    {
        @* Drawn by the script, which knows where the page stands: Word's ruler, with its markers. *@
        <div class="editor-ruler" aria-hidden="true"></div>
    }

    @if (errorMessage is not null)
    {
        <ErrorPanel Message="@errorMessage" IssueUrl="@issueUrl" />
    }

    @Body

    @if (HasDocument)
    {
        <div class="editor-status" role="status" aria-live="polite">
            <span class="editor-status-item">@($"{PageNounTitle} {currentPage} of {pageCount}")</span>
            @if (IsWord)
            {
                <button type="button" class="editor-status-item editor-status-button" title="Word count" @onclick="() => dialog = countDialog">
                    @WordsLabel
                </button>
                @if (Tracking)
                {
                    <span class="editor-status-item editor-status-tracking">Track changes on</span>
                }
                @if (!CanWrite)
                {
                    <span class="editor-status-item">Read-only</span>
                }
            }
            <span class="editor-status-note">@editNote</span>
            <span class="editor-status-zoom">
                <button type="button" class="viewer-button" title="Zoom out" aria-label="Zoom out" @onmousedown:preventDefault @onclick="() => ZoomByAsync(-1)">
                    <Iconify Value="Lucide.ZoomOut" aria-hidden="true" focusable="false" />
                </button>
                <span class="editor-zoom-value">@($"{Math.Round(scale * 100)}%")</span>
                <button type="button" class="viewer-button" title="Zoom in" aria-label="Zoom in" @onmousedown:preventDefault @onclick="() => ZoomByAsync(1)">
                    <Iconify Value="Lucide.ZoomIn" aria-hidden="true" focusable="false" />
                </button>
            </span>
        </div>
    }

    @if (menu is not null)
    {
        @* A press anywhere else closes a menu, and does nothing else — a right-click too. *@
        <div class="editor-backdrop" @onmousedown:preventDefault @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault></div>
    }

    @if (menu == contextMenu)
    {
        @* Word's right-click menu, where the pointer was (MorphEditor.ContextLines). *@
        @Menu("Context menu", ContextLines(), "editor-context-menu", ContextStyle)
    }

    @if (menu == fileMenu)
    {
        <div class="editor-menu editor-file-menu" role="menu" aria-label="File" @onkeydown="OnMenuKeyDown">
            @if (ShowNew)
            {
                <button type="button" role="menuitem" class="editor-menu-item" @onmousedown:preventDefault @onclick="NewAsync">
                    <Iconify Value="Lucide.FilePlus2" aria-hidden="true" focusable="false" />
                    New blank document
                </button>
            }
            @if (ShowOpenFile)
            {
                <label role="menuitem" class="editor-menu-item">
                    <Iconify Value="Lucide.FolderOpen" aria-hidden="true" focusable="false" />
                    Open…
                    <InputFile OnChange="OpenFromMenuAsync" class="file-input" accept="@ConversionService.ReadableAccept" aria-label="Open" />
                </label>
            }
            @if (HasDocument)
            {
                @if (SavesInPlace)
                {
                    <button type="button" role="menuitem" class="editor-menu-item" disabled="@saving" @onmousedown:preventDefault @onclick="SaveInPlaceFromMenuAsync">
                        <Iconify Value="Lucide.Save" aria-hidden="true" focusable="false" />
                        Save
                    </button>
                }
                @if (ShowDownload)
                {
                    <button type="button" role="menuitem" class="editor-menu-item" @onmousedown:preventDefault @onclick="SaveFromMenuAsync">
                        <Iconify Value="Lucide.Save" aria-hidden="true" focusable="false" />
                        Save a copy (@(sourceInfo?.Extension))
                    </button>
                }
                <div class="editor-menu-heading">Export as</div>
                @foreach (var format in ConversionService.WritableFormats)
                {
                    var chosen = format;
                    <button type="button" role="menuitem" class="editor-menu-item" @onmousedown:preventDefault @onclick="() => ExportFromMenuAsync(chosen.Format)">
                        <Iconify Value="Lucide.FileOutput" aria-hidden="true" focusable="false" />
                        @chosen.DisplayName (@chosen.Extension)
                    </button>
                }
                @if (ShowPrint)
                {
                    <div class="editor-menu-separator" role="separator"></div>
                    <button type="button" role="menuitem" class="editor-menu-item" @onmousedown:preventDefault @onclick="PrintFromMenuAsync">
                        <Iconify Value="Lucide.Printer" aria-hidden="true" focusable="false" />
                        Print…
                    </button>
                }
            }
        </div>
    }

    @if (dialog == linkDialog)
    {
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="editor-link-title" @onkeydown="OnLinkKeyDownAsync">
            <h2 id="editor-link-title" class="editor-dialog-title">@(InLink && linkTarget is not { HasSelection: true } ? "Link" : "Insert link")</h2>
            @if (linkTarget is { HasSelection: true })
            {
                <label class="editor-field">
                    Address
                    <input @ref="linkInput" type="url" class="editor-input" placeholder="https://example.com or #bookmark"
                           list="editor-link-places" value="@linkAddress" @oninput="OnLinkInput" />
                    @* The document's own places, as Word's dialog offers them under Place in This Document. *@
                    <datalist id="editor-link-places">
                        @foreach (var place in Bookmarks)
                        {
                            <option value="@($"#{place.Name}")"></option>
                        }
                    </datalist>
                </label>
            }
            <div class="editor-dialog-buttons">
                @if (InLink)
                {
                    <button type="button" class="editor-button" @onclick="RemoveLinkAsync">Remove link</button>
                }
                @if (linkTarget is { HasSelection: true })
                {
                    <button type="button" class="editor-button editor-button-primary" disabled="@(linkAddress.Trim().Length == 0)" @onclick="InsertLinkAsync">Insert</button>
                }
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }

    @if (dialog == paragraphDialog)
    {
        var fields = paragraphFields;
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog editor-dialog-wide" role="dialog" aria-modal="true" aria-labelledby="editor-paragraph-title" @onkeydown="OnFormDialogKeyDownAsync">
            <h2 id="editor-paragraph-title" class="editor-dialog-title">Paragraph</h2>
            <div class="editor-dialog-tabs" role="tablist">
                <button type="button" role="tab" class="editor-dialog-tab" aria-selected="@Pressed(paragraphPage == "indents")" @onclick='() => paragraphPage = "indents"'>Indents and Spacing</button>
                <button type="button" role="tab" class="editor-dialog-tab" aria-selected="@Pressed(paragraphPage == "breaks")" @onclick='() => paragraphPage = "breaks"'>Line and Page Breaks</button>
            </div>
            @if (paragraphPage == "indents")
            {
                <fieldset class="editor-fieldset">
                    <legend>General</legend>
                    <label class="editor-field editor-field-inline">
                        Alignment
                        <select class="editor-input" value="@fields.Alignment" @onchange='args => fields.Alignment = args.Value as string ?? "left"'>
                            <option value="left">Left</option>
                            <option value="center">Centered</option>
                            <option value="right">Right</option>
                            <option value="justify">Justified</option>
                        </select>
                    </label>
                </fieldset>
                <fieldset class="editor-fieldset">
                    <legend>Indentation</legend>
                    <div class="editor-field-grid">
                        <label class="editor-field">
                            Left (cm)
                            <input type="number" class="editor-input" step="0.1" value="@fields.Left" @oninput='args => fields.Left = args.Value as string ?? ""' />
                        </label>
                        <label class="editor-field">
                            Special
                            <select class="editor-input" value="@fields.Special" @onchange='args => fields.Special = args.Value as string ?? "none"'>
                                <option value="none">(none)</option>
                                <option value="first">First line</option>
                                <option value="hanging">Hanging</option>
                            </select>
                        </label>
                        <label class="editor-field">
                            Right (cm)
                            <input type="number" class="editor-input" step="0.1" value="@fields.Right" @oninput='args => fields.Right = args.Value as string ?? ""' />
                        </label>
                        <label class="editor-field">
                            By (cm)
                            <input type="number" class="editor-input" step="0.1" min="0" value="@fields.By" disabled="@(fields.Special == "none")"
                                   @oninput='args => fields.By = args.Value as string ?? ""' />
                        </label>
                    </div>
                </fieldset>
                <fieldset class="editor-fieldset">
                    <legend>Spacing</legend>
                    <div class="editor-field-grid">
                        <label class="editor-field">
                            Before (pt)
                            <input type="number" class="editor-input" step="6" min="0" value="@fields.Before" @oninput='args => fields.Before = args.Value as string ?? ""' />
                        </label>
                        <label class="editor-field">
                            Line spacing
                            <select class="editor-input" value="@fields.Line" @onchange="OnLineChosen">
                                @foreach (var (value, name) in LineChoices)
                                {
                                    <option value="@value">@name</option>
                                }
                            </select>
                        </label>
                        <label class="editor-field">
                            After (pt)
                            <input type="number" class="editor-input" step="6" min="0" value="@fields.After" @oninput='args => fields.After = args.Value as string ?? ""' />
                        </label>
                        <label class="editor-field">
                            At @AtUnit
                            <input type="number" class="editor-input" step="0.01" min="0" value="@fields.At" disabled="@(AtUnit.Length == 0)"
                                   @oninput='args => fields.At = args.Value as string ?? ""' />
                        </label>
                    </div>
                </fieldset>
            }
            else
            {
                <fieldset class="editor-fieldset">
                    <legend>Pagination</legend>
                    <label class="editor-check"><input type="checkbox" checked="@fields.WidowControl" @onchange="args => fields.WidowControl = args.Value is true" /> Widow/Orphan control</label>
                    <label class="editor-check"><input type="checkbox" checked="@fields.KeepNext" @onchange="args => fields.KeepNext = args.Value is true" /> Keep with next</label>
                    <label class="editor-check"><input type="checkbox" checked="@fields.KeepLines" @onchange="args => fields.KeepLines = args.Value is true" /> Keep lines together</label>
                    <label class="editor-check"><input type="checkbox" checked="@fields.PageBreakBefore" @onchange="args => fields.PageBreakBefore = args.Value is true" /> Page break before</label>
                </fieldset>
            }
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button editor-button-primary" disabled="@(ParagraphChange() is null)" @onclick="ParagraphFromDialogAsync">OK</button>
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }

    @if (dialog == fontDialog)
    {
        var fields = fontFields;
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog editor-dialog-wide" role="dialog" aria-modal="true" aria-labelledby="editor-font-title" @onkeydown="OnFormDialogKeyDownAsync">
            <h2 id="editor-font-title" class="editor-dialog-title">Font</h2>
            <div class="editor-field-grid editor-field-grid-three">
                <label class="editor-field">
                    Font
                    <input type="text" class="editor-input" list="editor-font-names" value="@fields.Font" @oninput='args => fields.Font = args.Value as string ?? ""' />
                    <datalist id="editor-font-names">
                        @foreach (var name in DocumentFonts.Concat(CommonFonts).Distinct(StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@name"></option>
                        }
                    </datalist>
                </label>
                <label class="editor-field">
                    Font style
                    <select class="editor-input" value="@fields.Style" @onchange='args => fields.Style = args.Value as string ?? "regular"'>
                        <option value="regular">Regular</option>
                        <option value="italic">Italic</option>
                        <option value="bold">Bold</option>
                        <option value="bolditalic">Bold Italic</option>
                    </select>
                </label>
                <label class="editor-field">
                    Size
                    <input type="number" class="editor-input" min="1" max="1638" step="0.5" list="editor-font-sizes" value="@fields.Size" @oninput='args => fields.Size = args.Value as string ?? ""' />
                    <datalist id="editor-font-sizes">
                        @foreach (var size in FontSizes)
                        {
                            <option value="@SizeLabel(size)"></option>
                        }
                    </datalist>
                </label>
                <label class="editor-field">
                    Font colour
                    <select class="editor-input" value="@fields.Color" @onchange="args => fields.Color = args.Value as string ?? automatic">
                        <option value="@automatic">Automatic</option>
                        @if (fields.Color != automatic && TextColors.All(_ => _.Hex != fields.Color))
                        {
                            <option value="@fields.Color">@($"#{fields.Color}")</option>
                        }
                        @foreach (var (hex, name) in TextColors)
                        {
                            <option value="@hex">@name</option>
                        }
                    </select>
                </label>
                <label class="editor-field">
                    Underline style
                    <select class="editor-input" value="@fields.Underline" @onchange='args => fields.Underline = args.Value as string ?? "none"'>
                        @foreach (var (value, name) in Underlines)
                        {
                            <option value="@value">@name</option>
                        }
                    </select>
                </label>
            </div>
            <fieldset class="editor-fieldset editor-effects">
                <legend>Effects</legend>
                <label class="editor-check"><input type="checkbox" checked="@fields.Strike" @onchange="args => SetStrike(args.Value is true)" /> Strikethrough</label>
                <label class="editor-check"><input type="checkbox" checked="@fields.SmallCaps" @onchange="args => SetSmallCaps(args.Value is true)" /> Small caps</label>
                <label class="editor-check"><input type="checkbox" checked="@fields.DoubleStrike" @onchange="args => SetDoubleStrike(args.Value is true)" /> Double strikethrough</label>
                <label class="editor-check"><input type="checkbox" checked="@fields.AllCaps" @onchange="args => SetAllCaps(args.Value is true)" /> All caps</label>
                <label class="editor-check"><input type="checkbox" checked="@fields.Superscript" @onchange="args => SetSuperscript(args.Value is true)" /> Superscript</label>
                <label class="editor-check"><input type="checkbox" checked="@fields.Hidden" @onchange="args => fields.Hidden = args.Value is true" /> Hidden</label>
                <label class="editor-check"><input type="checkbox" checked="@fields.Subscript" @onchange="args => SetSubscript(args.Value is true)" /> Subscript</label>
            </fieldset>
            <div class="editor-font-preview" aria-label="Preview"><span style="@FontPreview">@(fields.Font.Trim().Length > 0 ? fields.Font.Trim() : "Preview")</span></div>
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button editor-button-primary" disabled="@(FontChange() is null)" @onclick="FontFromDialogAsync">OK</button>
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }

    @if (dialog == bookmarkDialog)
    {
        var taken = DocumentEditor.IsBookmarkName(bookmarkName);
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="editor-bookmark-title" @onkeydown="OnBookmarkKeyDownAsync">
            <h2 id="editor-bookmark-title" class="editor-dialog-title">Bookmark</h2>
            <label class="editor-field">
                Bookmark name
                <input type="text" class="editor-input" autocomplete="off" value="@bookmarkName" @oninput="OnBookmarkInput" />
            </label>
            @if (bookmarkName.Length > 0 && !taken)
            {
                <p class="editor-dialog-note">A name starts with a letter, and holds only letters, numbers and underscores.</p>
            }
            <div class="editor-bookmarks" role="listbox" aria-label="Bookmarks">
                @if (Bookmarks.Count == 0)
                {
                    <p class="editor-dialog-note">The document has no bookmarks.</p>
                }
                @foreach (var place in Bookmarks)
                {
                    var name = place.Name;
                    <button type="button" role="option" class="editor-menu-item" aria-selected="@Pressed(name == bookmarkName)"
                            @onclick="() => bookmarkName = name">@name</button>
                }
            </div>
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button editor-button-primary" disabled="@(!taken)" @onclick="AddBookmarkFromDialogAsync">Add</button>
                <button type="button" class="editor-button" disabled="@(!BookmarkExists)" @onclick="DeleteBookmarkFromDialogAsync">Delete</button>
                <button type="button" class="editor-button" disabled="@(!BookmarkExists)" @onclick="GoToBookmarkFromDialogAsync">Go To</button>
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }

    @if (dialog == dateDialog)
    {
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="editor-date-title" @onkeydown="OnDialogKeyDown">
            <h2 id="editor-date-title" class="editor-dialog-title">Date and time</h2>
            <div class="editor-bookmarks" role="listbox" aria-label="Available formats">
                @foreach (var format in DateFormats)
                {
                    var chosen = format;
                    <button type="button" role="option" class="editor-menu-item" aria-selected="@Pressed(chosen == dateFormat)" data-format="@chosen"
                            @onclick="() => dateFormat = chosen" @ondblclick="DateFromDialogAsync">@DateLabel(chosen)</button>
                }
            </div>
            <label class="editor-check"><input type="checkbox" checked="@dateUpdates" @onchange="args => dateUpdates = args.Value is true" /> Update automatically</label>
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button editor-button-primary" @onclick="DateFromDialogAsync">Insert</button>
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }

    @if (dialog == marginsDialog)
    {
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="editor-margins-title" @onkeydown="OnMarginsKeyDownAsync">
            <h2 id="editor-margins-title" class="editor-dialog-title">Margins</h2>
            <div class="editor-margin-fields">
                @foreach (var side in marginSides)
                {
                    var name = side;
                    <label class="editor-field">
                        @name (cm)
                        <input type="number" class="editor-input" min="0" max="50" step="0.1" value="@customMargins[name]"
                               @oninput="args => customMargins[name] = args.Value?.ToString() ?? string.Empty" />
                    </label>
                }
            </div>
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button editor-button-primary" disabled="@(CustomMargins() is null)" @onclick="MarginsFromDialogAsync">Apply</button>
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }

    @if (dialog == splitDialog)
    {
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="editor-split-title" @onkeydown="OnSplitKeyDownAsync">
            <h2 id="editor-split-title" class="editor-dialog-title">Split cells</h2>
            <label class="editor-field">
                Columns
                <input type="number" class="editor-input" min="1" max="63" value="@splitColumns" @oninput="args => splitColumns = Count(args, splitColumns)" />
            </label>
            <label class="editor-field">
                Rows
                <input type="number" class="editor-input" min="1" max="63" value="@splitRows" @oninput="args => splitRows = Count(args, splitRows)" />
            </label>
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button editor-button-primary" disabled="@(splitColumns * splitRows <= 1)" @onclick="SplitFromDialogAsync">Split</button>
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }

    @if (dialog == countDialog)
    {
        var count = Count();
        var selected = CountSelected();
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="editor-count-title" @onkeydown="OnDialogKeyDown">
            <h2 id="editor-count-title" class="editor-dialog-title">Word count</h2>
            <dl class="editor-count">
                <dt>@($"{PageNounTitle}s")</dt><dd>@Number(count.Pages)</dd>
                <dt>Words</dt><dd>@Number(count.Words)</dd>
                <dt>Characters (no spaces)</dt><dd>@Number(count.Characters)</dd>
                <dt>Characters (with spaces)</dt><dd>@Number(count.CharactersWithSpaces)</dd>
                <dt>Paragraphs</dt><dd>@Number(count.Paragraphs)</dd>
                <dt>Lines</dt><dd>@Number(count.Lines)</dd>
            </dl>
            @if (selected is { } part)
            {
                <p class="editor-dialog-note">@($"Selected: {Number(part.Words)} words, {Number(part.Characters)} characters")</p>
            }
            <p class="editor-dialog-note">The document's body: headers, footers and notes are not counted.</p>
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button editor-button-primary" @onclick="CloseDialog">Close</button>
            </div>
        </div>
    }

    @if (dialog == discardDialog)
    {
        <div class="editor-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="editor-dialog" role="alertdialog" aria-modal="true" aria-labelledby="editor-discard-title" @onkeydown="OnDialogKeyDown">
            <h2 id="editor-discard-title" class="editor-dialog-title">Start a new document?</h2>
            <p class="editor-dialog-note">@fileName has edits that have not been saved. They are lost unless you save a copy first.</p>
            <div class="editor-dialog-buttons">
                <button type="button" class="editor-button" @onclick="SaveThenNewAsync">@(SavesInPlace ? "Save first" : "Save a copy first")</button>
                <button type="button" class="editor-button editor-button-danger" @onclick="DiscardThenNewAsync">Discard edits</button>
                <button type="button" class="editor-button" @onclick="CloseDialog">Cancel</button>
            </div>
        </div>
    }
</div>

@code {
    // The ribbon's tabs, as Word lays them out: groups of commands with their name under them, a group's
    // main command a large button with its label under its icon, the rest small buttons in rows or a
    // stack beside it. The group's name is its aria-label, which the stylesheet draws under it.
    //
    // Every button is drawn from its command (MorphEditor.Commands) by Tool, and every verb a menu offers
    // by MenuItem: whether it is greyed out, pressed or shown is the command's rule, asked of the state this
    // render worked out, so the markup here says only where a command goes and how it looks.

    // A command's button, drawn as the look asks. A button the script handles carries the command's name
    // for it, and no click of its own.
    RenderFragment Tool(EditorCommand command, ToolLook look, string? label = null, string? title = null, string? style = null, string? classes = null, RenderFragment? badge = null) =>
        @<button type="button" class="@ToolClass(look, classes)"
                 data-edit-command="@(command.Handler == CommandHandler.Script ? command.Name : null)"
                 data-viewer-action="@(command.Handler == CommandHandler.Viewer ? command.Name : null)"
                 title="@(title ?? TitleOf(command, look))" aria-label="@(look is ToolLook.Icon or ToolLook.Launcher ? label ?? command.Label : null)"
                 aria-keyshortcuts="@command.KeyShortcuts" aria-haspopup="@command.Opens" aria-expanded="@(command.Menu is { } name ? Expanded(name) : null)"
                 aria-pressed="@PressedOf(command)" style="@style" disabled="@Off(command)"
                 @onmousedown:preventDefault="@(command.Handler == CommandHandler.Component)" @onclick="ClickOf(command)">
            @if (command.Icon is { } icon)
            {
                <Iconify Value="icon" aria-hidden="true" focusable="false" />
            }
            @if (look is ToolLook.Large or ToolLook.Small)
            {
                @(label ?? command.Label)
            }
            @badge
            @if (look == ToolLook.Large && command.Menu is not null)
            {
                <Iconify Value="Lucide.ChevronDown" class="editor-caret" aria-hidden="true" focusable="false" />
            }
        </button>;

    // A group folded into one button, as Word's ribbon folds a group it has no room for: pressed, it opens
    // the group whole under it. Which groups are folded is the script's (foldRibbon in morph-viewer.js),
    // measured as the ribbon's width changes — a group's data-priority says how long it holds out, and
    // data-squeeze that it can first get smaller — so .NET draws both forms and the stylesheet shows one.
    RenderFragment Fold(string label, Icon icon) =>
        @<button type="button" class="editor-fold" aria-haspopup="true" aria-expanded="false" @onmousedown:preventDefault>
            <Iconify Value="icon" aria-hidden="true" focusable="false" />
            @label
            <Iconify Value="Lucide.ChevronDown" class="editor-caret" aria-hidden="true" focusable="false" />
        </button>;

    // A menu, drawn from its lines (MenuLine, made in MorphEditor.Menus): every dropdown of the ribbon
    // that is a list, and the right-click menu.
    RenderFragment Menu(string label, IReadOnlyList<MenuLine> lines, string? classes = null, string? style = null) =>
        @<div class="@(classes is null ? "editor-menu" : $"editor-menu {classes}")" role="menu" aria-label="@label" style="@style" @onkeydown="OnMenuKeyDown">
            @Lines(lines)
        </div>;

    // A command's line carries its name for the script when the script carries it out, as its button does.
    RenderFragment Lines(IReadOnlyList<MenuLine> lines) =>
        @<text>
            @foreach (var line in lines)
            {
                if (line.Kind == MenuLineKind.Separator)
                {
                    <div class="editor-menu-separator" role="separator"></div>
                }
                else if (line.Kind == MenuLineKind.Heading)
                {
                    <div class="editor-menu-heading">@line.Label</div>
                }
                else if (line.Lines is { } submenu)
                {
                    var open = openSubmenu == line.Label;
                    <div class="editor-menu-sub" data-open="@(open ? "true" : null)">
                        <button type="button" role="menuitem" class="editor-menu-item" aria-haspopup="menu" aria-expanded="@Pressed(open)"
                                @onmousedown:preventDefault @onclick="() => ToggleSubmenu(line.Label)">@line.Label</button>
                        @Menu(line.Label, submenu, "editor-submenu")
                    </div>
                }
                else
                {
                    <button type="button" role="@RoleOf(line)" class="@(line.Detail is null ? "editor-menu-item" : "editor-menu-item editor-menu-pair")"
                            data-edit-command="@(line.Command is {Handler: CommandHandler.Script} script ? script.Name : null)"
                            data-stays="@(line.StaysOpen ? "true" : null)"
                            aria-checked="@(line.Checked is { } on ? Pressed(on) : null)" disabled="@LineOff(line)"
                            @onmousedown:preventDefault @onclick="() => ChooseAsync(line)">
                        @if (line.Detail is { } detail)
                        {
                            <span>@line.Label</span>
                            <span class="editor-menu-detail">@detail</span>
                        }
                        else
                        {
                            @line.Label
                        }
                    </button>
                }
            }
        </text>;

    RenderFragment HomeTab =>
        @<text>
            <div class="editor-group" role="group" aria-label="Undo" data-priority="95">
                @Fold("Undo", Lucide.Undo2)
                <div class="editor-group-body">
                    <div class="editor-stack">
                        @Tool(Commands.Undo, ToolLook.Icon)
                        @Tool(Commands.Redo, ToolLook.Icon)
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Clipboard" data-priority="40" data-squeeze>
                @Fold("Clipboard", Lucide.ClipboardPaste)
                <div class="editor-group-body">
                    @* The clipboard's commands are the script's, inside the press itself: a browser lets a page
                       read or write the clipboard only from a user's gesture. *@
                    @Tool(Commands.Paste, ToolLook.Large)
                    <div class="editor-stack">
                        @Tool(Commands.Cut, ToolLook.Small)
                        @Tool(Commands.Copy, ToolLook.Small)
                        @Tool(Commands.FormatPainter, ToolLook.Small)
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Font" data-priority="90">
                @Fold("Font", Lucide.ALargeSmall)
                <div class="editor-group-body">
                    <div class="editor-rows">
                        <div class="editor-row">
                            @* The font and the size show what the caret is in: the script keeps data-value current
                               as the caret moves (data-edit-show), and the stylesheet draws it. *@
                            <span class="editor-anchor">
                                <button type="button" class="editor-dropdown editor-font-button" title="@Commands.Font.Title" aria-label="@Commands.Font.Label" aria-haspopup="@Commands.Font.Opens"
                                        aria-expanded="@Expanded(fontMenu)" disabled="@Off(Commands.Font)" @onmousedown:preventDefault @onclick="() => RunCommandAsync(Commands.Font)">
                                    <span class="editor-shown" data-edit-show="font" data-value="@CurrentFont"></span>
                                    <Iconify Value="Lucide.ChevronDown" aria-hidden="true" focusable="false" />
                                </button>
                                @if (menu == fontMenu)
                                {
                                    <div class="editor-menu editor-fonts" role="listbox" aria-label="Fonts" @onkeydown="OnMenuKeyDown">
                                        @if (DocumentFonts.Count > 0)
                                        {
                                            <div class="editor-menu-heading">In this document</div>
                                            @foreach (var each in DocumentFonts)
                                            {
                                                @FontChoice(each)
                                            }
                                            <div class="editor-menu-separator" role="separator"></div>
                                        }
                                        <div class="editor-menu-heading">Fonts</div>
                                        @foreach (var each in CommonFonts)
                                        {
                                            @FontChoice(each)
                                        }
                                        <p class="editor-menu-note">The pages here are drawn in Aptos; the font chosen is kept in the file.</p>
                                    </div>
                                }
                            </span>
                            <span class="editor-anchor">
                                <button type="button" class="editor-dropdown editor-size-button" title="@Commands.FontSize.Title" aria-label="@Commands.FontSize.Label" aria-haspopup="@Commands.FontSize.Opens"
                                        aria-expanded="@Expanded(sizeMenu)" disabled="@Off(Commands.FontSize)" @onmousedown:preventDefault @onclick="() => RunCommandAsync(Commands.FontSize)">
                                    <span class="editor-shown" data-edit-show="size" data-value="@SizeLabel(CurrentSize)"></span>
                                    <Iconify Value="Lucide.ChevronDown" aria-hidden="true" focusable="false" />
                                </button>
                                @if (menu == sizeMenu)
                                {
                                    <div class="editor-menu editor-sizes" role="listbox" aria-label="Font sizes" @onkeydown="OnMenuKeyDown">
                                        @foreach (var each in FontSizes)
                                        {
                                            var size = each;
                                            <button type="button" role="option" class="editor-menu-item" aria-selected="@Pressed(Math.Abs(CurrentSize - size) < 0.01)"
                                                    @onmousedown:preventDefault @onclick="() => SizeFromMenuAsync(size)">@SizeLabel(size)</button>
                                        }
                                    </div>
                                }
                            </span>
                            @Tool(Commands.Grow, ToolLook.Icon)
                            @Tool(Commands.Shrink, ToolLook.Icon)
                            @Tool(Commands.ClearFormatting, ToolLook.Icon)
                        </div>
                        <div class="editor-row">
                            @* Bold to strikethrough are the script's while a paragraph is open, which keeps which
                               of them are pressed as the caret moves. *@
                            @Tool(Commands.Bold, ToolLook.Icon)
                            @Tool(Commands.Italic, ToolLook.Icon)
                            @Tool(Commands.Underline, ToolLook.Icon)
                            @Tool(Commands.Strike, ToolLook.Icon)
                            @Tool(Commands.Subscript, ToolLook.Icon)
                            @Tool(Commands.Superscript, ToolLook.Icon)
                            <span class="viewer-divider" aria-hidden="true"></span>
                            <span class="editor-anchor">
                                @Tool(Commands.Highlight, ToolLook.Icon, style: $"--swatch: #{HighlightHex(LastHighlight)}", classes: "editor-swatch-button")
                                @Tool(Commands.Highlights, ToolLook.Icon, classes: "editor-split-arrow")
                                @if (menu == highlightMenu)
                                {
                                    <div class="editor-menu editor-palette" role="dialog" aria-label="Highlight" @onkeydown="OnMenuKeyDown">
                                        <div class="editor-swatches">
                                            @foreach (var (value, hex, name) in Highlights)
                                            {
                                                var highlight = value;
                                                <button type="button" class="editor-swatch" title="@name" aria-label="@name" style="background: #@hex"
                                                        @onmousedown:preventDefault @onclick="() => HighlightFromMenuAsync(highlight)"></button>
                                            }
                                        </div>
                                        <button type="button" class="editor-menu-item" @onmousedown:preventDefault @onclick="() => HighlightFromMenuAsync(noHighlight)">No colour</button>
                                    </div>
                                }
                            </span>
                            <span class="editor-anchor">
                                @Tool(Commands.FontColour, ToolLook.Icon, style: $"--swatch: #{LastColor}", classes: "editor-swatch-button")
                                @Tool(Commands.FontColours, ToolLook.Icon, classes: "editor-split-arrow")
                                @if (menu == colorMenu)
                                {
                                    <div class="editor-menu editor-palette" role="dialog" aria-label="Font colour" @onkeydown="OnMenuKeyDown">
                                        <button type="button" class="editor-menu-item" @onmousedown:preventDefault @onclick="() => ColorFromMenuAsync(automatic)">Automatic</button>
                                        <div class="editor-swatches">
                                            @foreach (var (hex, name) in TextColors)
                                            {
                                                var color = hex;
                                                <button type="button" class="editor-swatch" title="@name" aria-label="@name" style="background: #@color"
                                                        @onmousedown:preventDefault @onclick="() => ColorFromMenuAsync(color)"></button>
                                            }
                                        </div>
                                    </div>
                                }
                            </span>
                        </div>
                    </div>
                    @Tool(Commands.FontDialog, ToolLook.Launcher)
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Paragraph" data-priority="80">
                @Fold("Paragraph", Lucide.Pilcrow)
                <div class="editor-group-body">
                    <div class="editor-rows">
                        <div class="editor-row">
                            <span class="editor-anchor">
                                @Tool(Commands.Bullets, ToolLook.Icon)
                                @Tool(Commands.BulletLibrary, ToolLook.Icon, classes: "editor-split-arrow")
                                @if (menu == bulletsMenu)
                                {
                                    @ListLibrary("Bullet library", ListTemplates.Bullets, false)
                                }
                            </span>
                            <span class="editor-anchor">
                                @Tool(Commands.Numbering, ToolLook.Icon)
                                @Tool(Commands.NumberingLibrary, ToolLook.Icon, classes: "editor-split-arrow")
                                @if (menu == numberingMenu)
                                {
                                    @ListLibrary("Numbering library", ListTemplates.Numbers, true)
                                }
                            </span>
                            <span class="viewer-divider" aria-hidden="true"></span>
                            @Tool(Commands.DecreaseIndent, ToolLook.Icon)
                            @Tool(Commands.IncreaseIndent, ToolLook.Icon)
                            <span class="viewer-divider" aria-hidden="true"></span>
                            @Tool(Commands.Marks, ToolLook.Icon)
                        </div>
                        <div class="editor-row">
                            @Tool(Commands.AlignLeft, ToolLook.Icon)
                            @Tool(Commands.AlignCenter, ToolLook.Icon)
                            @Tool(Commands.AlignRight, ToolLook.Icon)
                            @Tool(Commands.Justify, ToolLook.Icon)
                            <span class="viewer-divider" aria-hidden="true"></span>
                            <span class="editor-anchor">
                                @Tool(Commands.Spacing, ToolLook.Icon, classes: "editor-dropdown-icon")
                                @if (menu == spacingMenu)
                                {
                                    @Menu(Commands.Spacing.Label, SpacingLines())
                                }
                            </span>
                            <span class="viewer-divider" aria-hidden="true"></span>
                            <span class="editor-anchor">
                                @Tool(Commands.ParagraphShading, ToolLook.Icon, style: $"--swatch: #{LastShading}", classes: "editor-swatch-button")
                                @Tool(Commands.ParagraphShadings, ToolLook.Icon, classes: "editor-split-arrow")
                                @if (menu == paragraphShadingMenu)
                                {
                                    <div class="editor-menu editor-palette" role="dialog" aria-label="Paragraph shading" @onkeydown="OnMenuKeyDown">
                                        <div class="editor-swatches">
                                            @foreach (var (hex, name) in ShadingColors)
                                            {
                                                var color = hex;
                                                <button type="button" class="editor-swatch" title="@name" aria-label="@name" style="background: #@color"
                                                        @onmousedown:preventDefault @onclick="() => ParagraphShadingFromMenuAsync(color)"></button>
                                            }
                                        </div>
                                        <button type="button" class="editor-menu-item" @onmousedown:preventDefault @onclick="() => ParagraphShadingFromMenuAsync(null)">No colour</button>
                                    </div>
                                }
                            </span>
                            <span class="editor-anchor">
                                @Tool(Commands.ParagraphBorders, ToolLook.Icon, title: ParagraphBorders.First(_ => _.Border == LastParagraphBorder).Name)
                                @Tool(Commands.MoreParagraphBorders, ToolLook.Icon, classes: "editor-split-arrow")
                                @if (menu == paragraphBordersMenu)
                                {
                                    @Menu(Commands.ParagraphBorders.Label, ParagraphBorderLines())
                                }
                            </span>
                        </div>
                    </div>
                    @Tool(Commands.ParagraphDialog, ToolLook.Launcher)
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Styles" data-priority="30" data-squeeze>
                @Fold("Styles", Lucide.Palette)
                <div class="editor-group-body">
                    @* Word's gallery: the styles drawn as their text is, a few rows at a time; the arrows page
                       through them, and the last opens them all. Each is a choice the Styles command offers. *@
                    <div class="editor-gallery" role="listbox" aria-label="Style gallery">
                        @foreach (var style in GalleryShown)
                        {
                            var choice = style;
                            <button type="button" role="option" class="editor-gallery-item" aria-selected="@Pressed(choice.Id == CurrentStyle)" title="@choice.Name"
                                    style="@GalleryPreview(choice)" disabled="@Off(Commands.Styles)" @onmousedown:preventDefault @onclick="() => StyleFromMenuAsync(choice.Id)">
                                <span class="editor-gallery-name">@choice.Name</span>
                            </button>
                        }
                    </div>
                    <span class="editor-anchor editor-gallery-arrows">
                        <button type="button" class="viewer-button" title="Previous styles" aria-label="Previous styles"
                                disabled="@(Off(Commands.Styles) || !CanPageGallery(-1))" @onmousedown:preventDefault @onclick="() => PageGallery(-1)">
                            <Iconify Value="Lucide.ChevronUp" aria-hidden="true" focusable="false" />
                        </button>
                        <button type="button" class="viewer-button" title="More styles" aria-label="More styles"
                                disabled="@(Off(Commands.Styles) || !CanPageGallery(1))" @onmousedown:preventDefault @onclick="() => PageGallery(1)">
                            <Iconify Value="Lucide.ChevronDown" aria-hidden="true" focusable="false" />
                        </button>
                        @Tool(Commands.Styles, ToolLook.Icon, label: $"Paragraph style: {CurrentStyleName}", classes: "editor-style-button")
                        @if (menu == stylesMenu)
                        {
                            <div class="editor-menu editor-styles" role="listbox" aria-label="Paragraph styles" @onkeydown="OnMenuKeyDown">
                                @foreach (var style in Styles)
                                {
                                    var choice = style;
                                    <button type="button" role="option" class="editor-menu-item editor-style" aria-selected="@(choice.Id == CurrentStyle ? "true" : "false")"
                                            style="@StylePreview(choice)" @onmousedown:preventDefault @onclick="() => StyleFromMenuAsync(choice.Id)">
                                        @choice.Name
                                    </button>
                                }
                            </div>
                        }
                    </span>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Editing" data-priority="10" data-squeeze>
                @Fold("Editing", Lucide.Search)
                <div class="editor-group-body">
                    <div class="editor-stack">
                        @Tool(Commands.Find, ToolLook.Small)
                        @Tool(Commands.Replace, ToolLook.Small)
                    </div>
                </div>
            </div>
        </text>;

    // Word's Bullets or Numbering library: an item per look, the caret's list's marked, and for
    // numbering Restart at 1 and Continue Numbering under it.
    RenderFragment ListLibrary(string label, IReadOnlyList<ListStyle> styles, bool numbering) =>
        @<div class="editor-menu editor-list-library" role="menu" aria-label="@label" @onkeydown="OnMenuKeyDown">
            @{ var current = CurrentListStyle; }
            <div class="editor-list-grid">
                @foreach (var style in styles)
                {
                    var chosen = style;
                    <button type="button" role="menuitemradio" class="editor-list-item" title="@chosen.Name" aria-label="@chosen.Name" aria-checked="@Pressed(chosen == current)"
                            @onmousedown:preventDefault @onclick="() => ListStyleFromMenuAsync(chosen)">@chosen.Shown</button>
                }
            </div>
            @if (numbering)
            {
                @Lines(NumberingLines())
            }
        </div>;

    // A font in the menu, drawn in itself where the browser has it.
    RenderFragment FontChoice(string font) =>
        @<button type="button" role="option" class="editor-menu-item editor-font" aria-selected="@Pressed(string.Equals(font, CurrentFont, StringComparison.OrdinalIgnoreCase))"
                 style="font-family: '@font', sans-serif" @onmousedown:preventDefault @onclick="() => FontFromMenuAsync(font)">@font</button>;

    RenderFragment LayoutTab =>
        @<text>
            <div class="editor-group" role="group" aria-label="Page setup" data-priority="50">
                @Fold("Page setup", Lucide.File)
                <div class="editor-group-body">
                    <span class="editor-anchor">
                        @Tool(Commands.Margins, ToolLook.Large)
                        @if (menu == marginsMenu)
                        {
                            @Menu(Commands.Margins.Label, MarginLines())
                        }
                    </span>
                    <span class="editor-anchor">
                        @Tool(Commands.Orientation, ToolLook.Large)
                        @if (menu == orientationMenu)
                        {
                            @Menu(Commands.Orientation.Label, OrientationLines())
                        }
                    </span>
                    <span class="editor-anchor">
                        @Tool(Commands.PaperSize, ToolLook.Large)
                        @if (menu == sizeOfPageMenu)
                        {
                            @Menu("Paper size", PaperLines())
                        }
                    </span>
                    <span class="editor-anchor">
                        @Tool(Commands.Columns, ToolLook.Large)
                        @if (menu == columnsMenu)
                        {
                            @Menu(Commands.Columns.Label, ColumnLines())
                        }
                    </span>
                    <span class="editor-anchor">
                        @Tool(Commands.Breaks, ToolLook.Large)
                        @if (menu == breaksMenu)
                        {
                            @Menu(Commands.Breaks.Label, BreakLines())
                        }
                    </span>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Arrange" data-priority="40">
                @Fold("Arrange", Lucide.WrapText)
                <div class="editor-group-body">
                    <span class="editor-anchor">
                        @Tool(Commands.Wrap, ToolLook.Large)
                        @if (menu == wrapMenu)
                        {
                            @Menu(Commands.Wrap.Label, WrapLines(CurrentWrap))
                        }
                    </span>
                </div>
            </div>
        </text>;

    RenderFragment InsertTab =>
        @<text>
            <div class="editor-group" role="group" aria-label="Pages" data-priority="20">
                @Fold("Pages", Lucide.SeparatorHorizontal)
                <div class="editor-group-body">
                    @Tool(Commands.PageBreak, ToolLook.Large)
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Tables" data-priority="60">
                @Fold("Tables", Lucide.Table)
                <div class="editor-group-body">
                    <span class="editor-anchor">
                        @Tool(Commands.Table, ToolLook.Large)
                        @if (menu == tableMenu)
                        {
                            <div class="editor-menu editor-grid-picker" role="dialog" aria-label="Insert table" @onkeydown="OnMenuKeyDown">
                                <div class="editor-menu-heading">@GridLabel</div>
                                <div class="editor-grid" style="--columns: @gridColumns">
                                    @for (var row = 1; row <= gridRows; row++)
                                    {
                                        for (var column = 1; column <= gridColumns; column++)
                                        {
                                            var size = (row, column);
                                            <button type="button" class="editor-grid-cell" aria-label="@($"{size.row} by {size.column}")"
                                                    data-lit="@(size.row <= hover.Rows && size.column <= hover.Columns ? "true" : null)"
                                                    @onmouseover="() => hover = size" @onfocus="() => hover = size"
                                                    @onmousedown:preventDefault @onclick="() => TableFromMenuAsync(size.row, size.column)"></button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </span>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Illustrations" data-priority="50">
                @Fold("Illustrations", Lucide.ImagePlus)
                <div class="editor-group-body">
                    @* The picker opens from the click itself, which a browser asks of a file input; where the
                       picture is to go is taken on the way. *@
                    <label class="editor-tool editor-large @(Off(Commands.Picture) ? "editor-tool-disabled" : "")" @onmousedown:preventDefault @onclick="() => RunCommandAsync(Commands.Picture)">
                        <Iconify Value="Lucide.ImagePlus" aria-hidden="true" focusable="false" />
                        @Commands.Picture.Label
                        <InputFile OnChange="InsertPictureAsync" class="file-input" accept=".png,.jpg,.jpeg,.gif,.bmp" aria-label="@Commands.Picture.Label" disabled="@Off(Commands.Picture)" />
                    </label>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Links" data-priority="40">
                @Fold("Links", Lucide.Link)
                <div class="editor-group-body">
                    @Tool(Commands.Link, ToolLook.Large)
                    @Tool(Commands.RemoveLink, ToolLook.Large)
                    @Tool(Commands.Bookmark, ToolLook.Large)
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Header and footer" data-priority="30">
                @Fold("Header and footer", Lucide.PanelTop)
                <div class="editor-group-body">
                    @Tool(Commands.Header, ToolLook.Large)
                    @Tool(Commands.Footer, ToolLook.Large)
                    <span class="editor-anchor">
                        @Tool(Commands.PageNumber, ToolLook.Large)
                        @if (menu == pageNumberMenu)
                        {
                            @Menu(Commands.PageNumber.Label, PageNumberLines())
                        }
                    </span>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Text" data-priority="10">
                @Fold("Text", Lucide.Type)
                <div class="editor-group-body">
                    @Tool(Commands.Date, ToolLook.Large)
                </div>
            </div>
        </text>;

    RenderFragment ReferencesTab =>
        @<text>
            <div class="editor-group" role="group" aria-label="Table of contents" data-priority="50">
                @Fold("Table of contents", Lucide.TableOfContents)
                <div class="editor-group-body">
                    @Tool(Commands.Contents, ToolLook.Large)
                    <div class="editor-stack">
                        @Tool(Commands.UpdateContents, ToolLook.Small)
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Footnotes" data-priority="40">
                @Fold("Footnotes", Lucide.Superscript)
                <div class="editor-group-body">
                    @Tool(Commands.Footnote, ToolLook.Large)
                    @Tool(Commands.Endnote, ToolLook.Large)
                </div>
            </div>
        </text>;

    RenderFragment TableTab =>
        @<text>
            <div class="editor-group" role="group" aria-label="Rows and columns" data-priority="60">
                @Fold("Rows and columns", Lucide.BetweenHorizontalEnd)
                <div class="editor-group-body">
                    @Tool(Commands.InsertRowAbove, ToolLook.Large)
                    @Tool(Commands.InsertRowBelow, ToolLook.Large)
                    <div class="editor-stack">
                        @Tool(Commands.InsertColumnLeft, ToolLook.Small)
                        @Tool(Commands.InsertColumnRight, ToolLook.Small)
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Delete" data-priority="50">
                @Fold("Delete", Lucide.Trash)
                <div class="editor-group-body">
                    <div class="editor-stack editor-stack-three">
                        @Tool(Commands.DeleteRow, ToolLook.Small)
                        @Tool(Commands.DeleteColumn, ToolLook.Small)
                        @Tool(Commands.DeleteTable, ToolLook.Small)
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Merge" data-priority="40">
                @Fold("Merge", Lucide.TableCellsMerge)
                <div class="editor-group-body">
                    <div class="editor-stack">
                        @Tool(Commands.MergeCells, ToolLook.Small)
                        @Tool(Commands.SplitCells, ToolLook.Small)
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Cell size" data-priority="30">
                @Fold("Cell size", Lucide.MoveHorizontal)
                <div class="editor-group-body">
                    <div class="editor-stack editor-stack-three">
                        <label class="editor-size-field" title="Column width, in centimetres">
                            <Iconify Value="Lucide.MoveHorizontal" aria-hidden="true" focusable="false" />
                            <input type="number" class="editor-input editor-width-input" min="0.1" max="55" step="0.1" placeholder="cm"
                                   aria-label="Column width in centimetres" disabled="@(!Commands.InATable(state))"
                                   value="@columnWidth" @onchange="OnColumnWidthAsync" />
                        </label>
                        @Tool(Commands.DistributeColumns, ToolLook.Small)
                        <span class="editor-anchor">
                            @Tool(Commands.AutoFit, ToolLook.Small)
                            @if (menu == fitMenu)
                            {
                                @Menu(Commands.AutoFit.Label, FitLines())
                            }
                        </span>
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Borders and shading" data-priority="20">
                @Fold("Borders and shading", Lucide.Grid2x2)
                <div class="editor-group-body">
                    <span class="editor-anchor">
                        @Tool(Commands.TableBorders, ToolLook.Large)
                        @if (menu == bordersMenu)
                        {
                            @Menu(Commands.TableBorders.Label, TableBorderLines())
                        }
                    </span>
                    <span class="editor-anchor">
                        @Tool(Commands.CellShading, ToolLook.Icon, style: $"--swatch: #{LastShading}", classes: "editor-swatch-button")
                        @Tool(Commands.CellShadings, ToolLook.Icon, classes: "editor-split-arrow")
                        @if (menu == shadingMenu)
                        {
                            <div class="editor-menu editor-palette" role="dialog" aria-label="Shading" @onkeydown="OnMenuKeyDown">
                                <div class="editor-swatches">
                                    @foreach (var (hex, name) in ShadingColors)
                                    {
                                        var color = hex;
                                        <button type="button" class="editor-swatch" title="@name" aria-label="@name" style="background: #@color"
                                                @onmousedown:preventDefault @onclick="() => ShadingFromMenuAsync(color)"></button>
                                    }
                                </div>
                                <button type="button" class="editor-menu-item" @onmousedown:preventDefault @onclick="() => ShadingFromMenuAsync(null)">No colour</button>
                            </div>
                        }
                    </span>
                </div>
            </div>
        </text>;

    RenderFragment ReviewTab =>
        @<text>
            <div class="editor-group" role="group" aria-label="Proofing" data-priority="10">
                @Fold("Proofing", Lucide.WholeWord)
                <div class="editor-group-body">
                    @Tool(Commands.WordCount, ToolLook.Large)
                </div>
            </div>
            @if (Shown(Commands.ReviewPane))
            {
                <div class="editor-group" role="group" aria-label="Comments" data-priority="50">
                    @Fold("Comments", Lucide.MessageSquare)
                    <div class="editor-group-body">
                        @Tool(Commands.NewComment, ToolLook.Large)
                        @Tool(Commands.ReviewPane, ToolLook.Large, badge: ReviewBadge)
                    </div>
                </div>
            }
            <div class="editor-group" role="group" aria-label="Tracking" data-priority="60">
                @Fold("Tracking", Lucide.FilePenLine)
                <div class="editor-group-body">
                    @Tool(Commands.Track, ToolLook.Large, title: TrackTitle, classes: "viewer-edit-track")
                    @if (Tracking && Author is not { Length: > 0 })
                    {
                        <label class="viewer-edit-signature">
                            as
                            <input type="text" class="review-signature-input" placeholder="@guest" autocomplete="name"
                                   aria-label="Your name" value="@authorName" @oninput="OnAuthorInput" />
                        </label>
                    }
                </div>
            </div>
            @if (Shown(Commands.AcceptAll))
            {
                <div class="editor-group" role="group" aria-label="Changes" data-priority="40">
                    @Fold("Changes", Lucide.CheckCheck)
                    <div class="editor-group-body">
                        @Tool(Commands.AcceptAll, ToolLook.Large)
                        @Tool(Commands.RejectAll, ToolLook.Large)
                    </div>
                </div>
            }
        </text>;

    // How many comments and changes are open, on the button that shows them.
    RenderFragment ReviewBadge =>
        @<text>
            @if (OpenItems > 0)
            {
                <span class="viewer-badge editor-badge" title="@($"{OpenItems} to review")">@OpenItemsLabel</span>
            }
        </text>;

    RenderFragment ViewTab =>
        @<text>
            <div class="editor-group" role="group" aria-label="Show" data-priority="30">
                @Fold("Show", Lucide.PanelLeft)
                <div class="editor-group-body">
                    @Tool(Commands.Pages, ToolLook.Large, label: $"{PageNounTitle}s")
                    @if (Shown(Commands.Ruler))
                    {
                        @Tool(Commands.Ruler, ToolLook.Large)
                    }
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Zoom" data-priority="60">
                @Fold("Zoom", Lucide.ZoomIn)
                <div class="editor-group-body">
                    <div class="editor-row">
                        @ZoomControls
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Go to" data-priority="40">
                @Fold("Go to", Lucide.Navigation)
                <div class="editor-group-body">
                    <div class="editor-row">
                        @PageNavigation
                    </div>
                </div>
            </div>
            <div class="editor-group" role="group" aria-label="Present" data-priority="20">
                @Fold("Present", Lucide.Presentation)
                <div class="editor-group-body">
                    @* Handled by the script, inside the click itself: fullscreen is only granted to a user gesture. *@
                    @Tool(Commands.Present, ToolLook.Large)
                </div>
            </div>
        </text>;

    // A new document, or one opened: what the editor shows while nothing is open.
    internal override RenderFragment EmptyState =>
        @<div class="viewer-empty editor-start">
            <p class="viewer-empty-title">Write a document</p>
            <p class="viewer-empty-note">Start a new Word document, or open a .docx to edit. Nothing leaves this device.</p>
            @if (recovery is { } found)
            {
                <div class="editor-recover" role="group" aria-label="Unsaved document">
                    <Iconify Value="Lucide.FileClock" aria-hidden="true" focusable="false" />
                    <span class="editor-recover-text"><strong>@found.Name</strong> was edited on @recoveryTime and not saved.</span>
                    <button type="button" class="editor-button editor-button-primary" @onclick="RecoverAsync">Recover</button>
                    <button type="button" class="editor-button" @onclick="DiscardRecoveryAsync">Discard</button>
                </div>
            }
            @if (recoveryNote is { } note)
            {
                <p class="viewer-empty-note" role="status">@note</p>
            }
            <div class="editor-start-actions">
                <button type="button" class="editor-start-new" @onclick="NewAsync">
                    <Iconify Value="Lucide.FilePlus2" aria-hidden="true" focusable="false" />
                    Blank document
                </button>
                @if (ShowOpenFile)
                {
                    <button type="button" class="viewer-empty-open" data-viewer-action="open">Open a file</button>
                }
            </div>
            @if (ShowOpenFile)
            {
                <p class="viewer-empty-note">or drop one anywhere here</p>
            }
            @if (ShowSamples)
            {
                <div class="sample-row">
                    <button type="button" class="sample-btn" @onclick="() => LoadSampleAsync(ConversionService.Find(InputFormat.Docx))">
                        <Iconify Value="Lucide.FileText" aria-hidden="true" focusable="false" />
                        Sample Word document
                    </button>
                </div>
            }
        </div>;
}

@inject MorphInterop Interop

@* Stacks one image per rendered page, scrolling when a long document exceeds the cap. Presentational
   only: it shows pages that have already been rendered, so a host that wants its own layout can call
   ConversionService.RenderPages itself and feed the results in here. Each page with a text layer gets an
   overlay the script fills with selectable text; Blazor renders that overlay empty and never touches it. *@

<div class="preview">
    @if (Busy)
    {
        <div class="preview-busy">
            <ConversionProgress Label="@Label" Detail="@Detail" />
        </div>
    }
    else
    {
        @for (var index = 0; index < Pages.Count; index++)
        {
            var pageIndex = index;
            var layer = LayerAt(pageIndex);
            <div class="preview-sheet" @key="(object?) layer ?? Pages[pageIndex]">
                @* With a text layer the text is the page's content, so the picture of it is decorative. *@
                <img class="preview-page" src="@Pages[pageIndex]" alt="@(layer is null ? PageAlt : "")" />
                @if (layer is not null)
                {
                    <div class="text-layer" @ref="textLayerElements[pageIndex]"></div>
                }
            </div>
        }
    }
</div>

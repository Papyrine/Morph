<div class="theme-toggle">
    <button class="theme-toggle-btn" @onclick="ToggleTheme" aria-label="Toggle theme">
        @if (CurrentTheme == ThemeType.Light)
        {
            <Iconify Value="Lucide.Moon" class="icon" aria-hidden="true" focusable="false" /><span class="text"> Dark</span>
        }
        else
        {
            <Iconify Value="Lucide.Sun" class="icon" aria-hidden="true" focusable="false" /><span class="text"> Light</span>
        }
    </button>
</div>

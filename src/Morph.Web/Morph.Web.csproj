<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- App, not a package: no XML docs. ProjectDefaults turns on GenerateDocumentationFile in Release,
         which (with TreatWarningsAsErrors) would fail on every undocumented component/parameter. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Selective trim. Trimming is ON so the BCL, the ASP.NET Components framework and Morph's own
      assemblies (verified reflection-free) shrink to what's actually reached. The conversion pipeline's
      reflection-heavy libraries are rooted (kept whole) instead — those TrimmerRootAssembly items live in
      Morph.Blazor's build/Morph.Blazor.targets, which is shipped in its NuGet package so every consuming
      app gets the same protection. This app picks the file up by path, since a ProjectReference doesn't
      import a referenced project's MSBuild assets the way a PackageReference does.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Single-threaded runtime (WasmEnableThreads deliberately NOT set). The multithreaded runtime needs
      SharedArrayBuffer, i.e. a cross-origin-isolated page, which a service-worker shim can't reliably
      guarantee across every serving context — and when it isn't isolated the threaded runtime aborts at
      startup (mono_wasm_register_ui_thread stack-bounds assertion). Single-threaded boots reliably
      anywhere with no isolation and no coi.js. (The deploy is AOT-compiled, which has nothing to do with
      threads: .github/workflows/deploy-blazor.yml passes RunAOTCompilation on its publish line, and
      nothing here turns it on, so local builds and the tests' publish stay interpreted. The workarounds
      AOT needs are in Morph.Blazor's build/Morph.Blazor.targets.) The trade-off: a conversion
      runs on the UI thread, so the page is briefly unresponsive while it works (Task.Run still lets the
      "rendering" state paint before the compute begins). For 1–3 page documents that's a blink.
    -->
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!--
      REQUIRED: the PDF export is Krilla, whose browser-wasm native is a static archive that has to be
      linked into this app's own .wasm (Krilla's buildTransitive targets hand it to the link step). Only a
      native build links it, so without this the app builds, runs, and fails on the first PDF with
      "krilla_capi could not be loaded". Needs the wasm-tools workload: `dotnet workload install wasm-tools`.
    -->
    <WasmBuildNative>true</WasmBuildNative>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- The host `dotnet run` (and an IDE's Run) launches. Without it the SDK falls back to WasmAppHost,
         which answers every request, index.html included, with a 404. Development only: it is not part
         of the published site. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <!-- The theme toggle's sun and moon. A pack's generator compiles in only the icons a project names,
         and it runs in each project that references the pack, so this app references it as well as the
         package does. -->
    <PackageReference Include="IconifyBundle.Blazor" />
    <PackageReference Include="IconifyBundle.Lucide" />
    <!-- The converter itself: components, conversion services, and the fonts / samples / stylesheet /
         script they need, all as static web assets. Drags in Morph.ImageSharp (PNG — pure-managed, so it
         runs in WebAssembly) and Morph.Pdf (PDF); Skia is deliberately avoided, it needs a native
         WebAssembly build the NuGet assets don't ship. -->
    <ProjectReference Include="..\Morph.Blazor\Morph.Blazor.csproj" />
  </ItemGroup>

  <Import Project="..\Morph.Blazor\build\Morph.Blazor.targets" />

  <!--
    js/version.js: the version the footer shows (v1.22.0+b4bbab2), for index.html's loading screen, which
    has to show it before .NET is running — a page the browser kept from an earlier deploy is then plain
    to see. Written to obj and linked into wwwroot, so it is a static web asset like any other, in every
    build and publish, and nothing generated lands in the source tree. Rewriting index.html after publish
    instead would leave its .br/.gz beside it stale.
  -->
  <Target Name="WriteVersionScript"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_MorphShortSha>$(SourceRevisionId)</_MorphShortSha>
      <_MorphShortSha Condition="$(SourceRevisionId.Length) &gt; 7">$(SourceRevisionId.Substring(0, 7))</_MorphShortSha>
      <_MorphVersionText>v$(Version)</_MorphVersionText>
      <_MorphVersionText Condition="'$(_MorphShortSha)' != ''">$(_MorphVersionText)+$(_MorphShortSha)</_MorphVersionText>
      <_MorphVersionScript>$(IntermediateOutputPath)version.js</_MorphVersionScript>
    </PropertyGroup>
    <WriteLinesToFile File="$(_MorphVersionScript)"
                      Lines="window.morphVersion = '$(_MorphVersionText)'%3B"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(_MorphVersionScript)" Link="wwwroot\js\version.js" />
      <FileWrites Include="$(_MorphVersionScript)" />
    </ItemGroup>
  </Target>

</Project>

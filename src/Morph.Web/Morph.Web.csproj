<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- App, not a package: no XML docs. ProjectDefaults turns on GenerateDocumentationFile in Release,
         which (with TreatWarningsAsErrors) would fail on every undocumented component/parameter. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Trimming is OFF. The conversion pipeline drags DocumentFormat.OpenXml and AngleSharp (both
      heavily reflection-based) plus ImageSharp and PdfSharp; full-trim silently removes types they
      resolve by name at runtime, which surfaces only as a browser-side crash mid-conversion. The
      untrimmed bundle is larger but correct. Revisit with a curated ILLink descriptor if size matters.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Single-threaded runtime (WasmEnableThreads deliberately NOT set). The multithreaded runtime needs
      SharedArrayBuffer, i.e. a cross-origin-isolated page, which a service-worker shim can't reliably
      guarantee across every serving context — and when it isn't isolated the threaded runtime aborts at
      startup (mono_wasm_register_ui_thread stack-bounds assertion). Single-threaded boots reliably
      anywhere with no isolation, no coi.js, and no wasm-tools/emcc relink. The trade-off: a conversion
      runs on the UI thread, so the page is briefly unresponsive while it works (Task.Run still lets the
      "rendering" state paint before the compute begins). For 1–3 page documents that's a blink.
    -->
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <!-- AngleSharp parses Morph's exported HTML into a plain-text (.txt) rendition — Morph itself
         ships only HTML and Markdown exporters. It arrives transitively via Morph already; the
         explicit reference makes the dependency intentional rather than incidental. -->
    <PackageReference Include="AngleSharp" />
    <!-- ImageSharp backend (pure-managed, runs in WASM) for DOCX->PNG; PdfSharp for DOCX->PDF.
         Skia is deliberately avoided — it needs a native WebAssembly build the NuGet assets don't ship. -->
    <ProjectReference Include="..\Morph.ImageSharp\Morph.ImageSharp.csproj" />
    <ProjectReference Include="..\Morph.Pdf\Morph.Pdf.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- App, not a package: no XML docs. ProjectDefaults turns on GenerateDocumentationFile in Release,
         which (with TreatWarningsAsErrors) would fail on every undocumented component/parameter. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Selective trim. Trimming is ON so the BCL, the ASP.NET Components framework and Morph's own
      assemblies (verified reflection-free) shrink to what's actually reached. The conversion pipeline's
      four reflection-heavy libraries — DocumentFormat.OpenXml, AngleSharp, ImageSharp (+ Drawing/Fonts)
      and PdfSharp — resolve types by name at runtime, so full-trim would silently strip types they need
      and surface only as a browser-side crash mid-conversion. Those are rooted (kept whole) via the
      TrimmerRootAssembly items below. Residual risk: a rooted library reflecting into a *framework* type
      the trimmer removed — validate any change here by running a real DOCX through every output format on
      the published build (the Playwright suite in Morph.Web.Tests exercises DOCX->PNG and DOCX->PDF).
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Single-threaded runtime (WasmEnableThreads deliberately NOT set). The multithreaded runtime needs
      SharedArrayBuffer, i.e. a cross-origin-isolated page, which a service-worker shim can't reliably
      guarantee across every serving context — and when it isn't isolated the threaded runtime aborts at
      startup (mono_wasm_register_ui_thread stack-bounds assertion). Single-threaded boots reliably
      anywhere with no isolation, no coi.js, and no wasm-tools/emcc relink. The trade-off: a conversion
      runs on the UI thread, so the page is briefly unresponsive while it works (Task.Run still lets the
      "rendering" state paint before the compute begins). For 1–3 page documents that's a blink.
    -->
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <!-- AngleSharp parses Morph's exported HTML into a plain-text (.txt) rendition — Morph itself
         ships only HTML and Markdown exporters. It arrives transitively via Morph already; the
         explicit reference makes the dependency intentional rather than incidental. -->
    <PackageReference Include="AngleSharp" />
    <!-- ImageSharp backend (pure-managed, runs in WASM) for DOCX->PNG; PdfSharp for DOCX->PDF.
         Skia is deliberately avoided — it needs a native WebAssembly build the NuGet assets don't ship. -->
    <ProjectReference Include="..\Morph.ImageSharp\Morph.ImageSharp.csproj" />
    <ProjectReference Include="..\Morph.Pdf\Morph.Pdf.csproj" />
  </ItemGroup>

  <!-- Reflection-heavy libraries preserved whole under trimming (see PublishTrimmed note above).
       Names are logical assembly names; each is rooted so none of its own members are removed. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="DocumentFormat.OpenXml" />
    <TrimmerRootAssembly Include="DocumentFormat.OpenXml.Framework" />
    <TrimmerRootAssembly Include="AngleSharp" />
    <TrimmerRootAssembly Include="SixLabors.ImageSharp" />
    <TrimmerRootAssembly Include="SixLabors.ImageSharp.Drawing" />
    <TrimmerRootAssembly Include="SixLabors.Fonts" />
    <TrimmerRootAssembly Include="SixLabors.PolygonClipper" />
    <TrimmerRootAssembly Include="PdfSharp" />
    <TrimmerRootAssembly Include="PdfSharp.Charting" />
    <TrimmerRootAssembly Include="PdfSharp.Cryptography" />
    <TrimmerRootAssembly Include="PdfSharp.Shared" />
    <TrimmerRootAssembly Include="PdfSharp.System" />
    <TrimmerRootAssembly Include="PdfSharp.WPFonts" />
  </ItemGroup>

</Project>
